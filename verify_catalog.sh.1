#!/usr/bin/env bash

# ==============================================================================
# Strict Error Handling & Best Practices
# ==============================================================================
set -euo pipefail

# ==============================================================================
# Helper Functions
# ==============================================================================
error_exit() {
    local message="$1"
    echo "ERROR: ${message}" >&2
    exit 1
}

log_info() {
    local message="$1"
    echo "INFO: ${message}"
}

verify_image_exists() {
    local image_uri="$1"
    
    # Skopeo inspect queries the remote registry metadata efficiently without pulling layers
    if skopeo inspect --raw "docker://${image_uri}" > /dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# ==============================================================================
# Input Validation
# ==============================================================================
if [[ $# -ne 1 ]]; then
    error_exit "Usage: $0 <path_to_catalog.json>"
fi

CATALOG_FILE="$1"

if [[ ! -f "${CATALOG_FILE}" ]]; then
    error_exit "Catalog file not found: ${CATALOG_FILE}"
}

# Define temporary work files securely
TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "${TEMP_DIR}"' EXIT

RAW_OUTPUT_JSON="${TEMP_DIR}/output.json"
echo '{}' > "${RAW_OUTPUT_JSON}"

# ==============================================================================
# Main Processing Logic
# ==============================================================================
log_info "Parsing channels from OLM catalog..."

# Extract all unique channel names from the catalog
mapfile -t CHANNELS < <(jq -r 'select(.schema == "olm.channel") | .name' "${CATALOG_FILE}")

if [[ ${#CHANNELS[@]} -eq 0 ]]; then
    error_exit "No channels found in the provided catalog file."
fi

# Iterate over each found channel track
for channel in "${CHANNELS[@]}"; do
    log_info "----------------=================================="
    log_info "Processing Channel: ${channel}"
    log_info "----------------=================================="
    
    # Track if we added any verified versions to this specific channel
    local versions_added_for_channel=0

    # Get all entries (versions) associated with the current loop channel
    mapfile -t BUNDLE_VERSIONS < <(jq -r --arg chan "${channel}" 'select(.schema == "olm.channel" and .name == $chan) | .entries[].name' "${CATALOG_FILE}")
    
    for version in "${BUNDLE_VERSIONS[@]}"; do
        log_info "Validating Operator Version: ${version}"
        
        # Extract related images for this specific bundle version
        mapfile -t RELATED_IMAGES < <(jq -r --arg ver "${version}" 'select(.schema == "olm.bundle" and .name == $ver) | .relatedImages[].image' "${CATALOG_FILE}")
        
        # Include the base bundle image path if specified in the schema top-level
        BASE_IMAGE="$(jq -r --arg ver "${version}" 'select(.schema == "olm.bundle" and .name == $ver) | .image' "${CATALOG_FILE}")"
        if [[ -n "${BASE_IMAGE}" && "${BASE_IMAGE}" != "null" ]]; then
            RELATED_IMAGES+=("${BASE_IMAGE}")
        fi

        if [[ ${#RELATED_IMAGES[@]} -eq 0 ]]; then
            echo "  ⚠️  No container images found for ${version}. Skipping."
            continue
        fi

        VERSION_VALID=true
        
        # Check all collected images against the remote container registry
        for img in "${RELATED_IMAGES[@]}"; do
            echo -n "  🔎 Checking registry for image: ${img} ... "
            if verify_image_exists "${img}"; then
                echo "✅ EXISTS"
            else
                echo "❌ NOT FOUND"
                VERSION_VALID=false
                break # Fail fast if any single image dependencies are missing
            fi
        done
        
        # If all associated images are validated, append to our tracking ledger object
        if [[ "${VERSION_VALID}" == "true" ]]; then
            log_info "  🎉 Version ${version} is completely verified! Adding to output channel stack."
            
            # Construct standard config mapping entries array matching OLM entry specification blocks
            jq --arg chan "${channel}" --arg ver "${version}" \
               '.[$chan] += [{"name": $ver}]' "${RAW_OUTPUT_JSON}" > "${RAW_OUTPUT_JSON}.tmp"
            mv "${RAW_OUTPUT_JSON}.tmp" "${RAW_OUTPUT_JSON}"
            
            ((versions_added_for_channel++))
        else
            echo "  ⛔ Version ${version} validation failed due to missing dependencies. Omitted."
        fi
    done

    # If versions were verified, we mix in the base structure parameters (name, package, schema) 
    # to make the structural document look exactly like an 'olm.channel' layout block type.
    if [[ ${versions_added_for_channel} -gt 0 ]]; then
        # Fetch the original contextual fields (package, schema) from the source catalog entry match
        PACKAGE_NAME="$(jq -r --arg chan "${channel}" 'select(.schema == "olm.channel" and .name == $chan) | .package' "${CATALOG_FILE}")"
        SCHEMA_TYPE="$(jq -r --arg chan "${channel}" 'select(.schema == "olm.channel" and .name == $chan) | .schema' "${CATALOG_FILE}")"
        
        # Format the isolated verified array block back into a top-level typed catalog document entry map
        jq --arg chan "${channel}" --arg pkg "${PACKAGE_NAME}" --arg sch "${SCHEMA_TYPE}" \
           '.[$chan] = {"entries": .[$chan], "name": $chan, "package": $pkg, "schema": $sch}' "${RAW_OUTPUT_JSON}" > "${RAW_OUTPUT_JSON}.tmp"
        mv "${RAW_OUTPUT_JSON}.tmp" "${RAW_OUTPUT_JSON}"
    else
        log_info "  🗑️  No valid versions found under channel '${channel}'. Dropping channel entirely."
    fi
done

# ==============================================================================
# Save and finalize validated structural format config ledger
# ==============================================================================
CONFIG_OUTPUT="config.json"

# Flatten the indexed root dictionary into a clean collection stream array 
# of standalone document lines, mirroring the exact raw OLM input structure format.
jq -c '.[]' "${RAW_OUTPUT_JSON}" > "${CONFIG_OUTPUT}"

log_info "=================================================="
log_info "Process Finished Successfully! Verified configurations written to: ${CONFIG_OUTPUT}"
log_info "=================================================="